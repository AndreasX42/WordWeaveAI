# AWS Configuration
aws_region = "us-east-1"
aws_profile = "personal"
terraform_assume_role_arn = "arn:aws:iam::123456789012:role/wordweave-terraform"

# Project Configuration
project_name = "wordweave"

# ECR Repository Names
ecr_frontend_repo_name = "wordweave-frontend"
ecr_backend_repo_name  = "wordweave-restapi"

# Domain Configuration
domain_name = "example.com"  # Replace with your actual domain