bucket         = "REPLACE_ME_terraform_state_bucket"
key            = "common/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "REPLACE_ME_terraform_lock_table"
encrypt        = true

# Optional but recommended: backend assume role (same role used by provider)
role_arn       = "arn:aws:iam::123456789012:role/wordweave-terraform"

