# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key
JWT_EXPIRATION_TIME=60
JWT_MAX_REFRESH_HOURS=24

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
CORS_MAX_AGE_HOURS=12

# Server
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=5000
FRONTEND_URL=http://localhost:4200
FRONTEND_ALLOWED_URLS=http://localhost:4200,https://wordweave.xyz
DEFAULT_REQUEST_TIMEOUT_MS=1000
SEARCH_REQUEST_TIMEOUT_MS=1500
HEALTH_REQUEST_TIMEOUT_MS=500
STATS_CACHE_TTL_SECONDS=300
DYNAMODB_TABLE_PREFIX=dev
DYNAMODB_USER_TABLE_NAME=Users
DYNAMODB_VOCAB_TABLE_NAME=Vocabs
DYNAMODB_VOCAB_LIST_TABLE_NAME=VocabLists
DYNAMODB_VOCAB_MEDIA_TABLE_NAME=VocabMedia
DYNAMODB_AUTO_CREATE_TABLES=true
DYNAMODB_TABLE_WAIT_TIMEOUT_SECONDS=60

# Vocab search fallback (scan)
VOCAB_SEARCH_SCAN_TIMEOUT_MS=300
VOCAB_SEARCH_SCAN_PAGE_SIZE=250
VOCAB_SEARCH_SCAN_MAX_ITEMS=2000

# SQS
SQS_VOCAB_REQUEST_QUEUE_URL=

# SES
SES_FROM_EMAIL=
SES_FROM_NAME=
SES_SEND_TIMEOUT_MS=30000

# AWS HTTP client (used for DynamoDB/SES/SQS SDK calls)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_HTTP_TIMEOUT_MS=10000
AWS_HTTP_MAX_CONNS_PER_HOST=50
AWS_HTTP_MAX_IDLE_CONNS=100
AWS_HTTP_MAX_IDLE_CONNS_PER_HOST=20
AWS_HTTP_IDLE_CONN_TIMEOUT_MS=120000
AWS_HTTP_RESPONSE_HEADER_TIMEOUT_MS=5000

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_SLOW_REQUEST_THRESHOLD_MS=5000

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# App Configuration
MAX_VOCAB_REQUESTS_FREE_TIER=
APP_VERSION=